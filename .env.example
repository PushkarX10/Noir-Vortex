# ============================================================
# THE LOOP — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# Missing keys will trigger graceful fallbacks with clear errors.
# ============================================================

# --- LLM Providers (at least one required) ---
# The system uses LiteLLM to route to any provider.
# Set your preferred default in LLM_PROVIDER below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Which LLM provider to use by default: "openai", "anthropic", or "google"
LLM_PROVIDER=openai
# Which model to use (leave blank for provider default)
LLM_MODEL=

# --- Instagram (Meta Graph API) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- TikTok Content Posting API ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- X / Twitter API v2 ---
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Reddit API (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TheLoop/1.0

# --- LinkedIn Marketing API ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# --- Application Settings ---
# Dashboard host/port
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Database path for LangGraph checkpointer
DATABASE_PATH=./data/theloop.db

# Content output directory
CONTENT_OUTPUT_DIR=./output

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
